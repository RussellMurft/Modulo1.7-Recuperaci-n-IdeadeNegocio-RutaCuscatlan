{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "780px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {
          "slug": "ocean",
          "name": "Azul océano",
          "color": "#123B46"
        },
        {
          "slug": "forest",
          "name": "Verde bosque",
          "color": "#276B55"
        },
        {
          "slug": "sun",
          "name": "Dorado",
          "color": "#E9B95D"
        },
        {
          "slug": "sand",
          "name": "Arena",
          "color": "#F6F3EA"
        },
        {
          "slug": "ink",
          "name": "Tinta",
          "color": "#1E3030"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "system",
          "name": "Sistema"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#FCFBF7",
      "text": "#1E3030"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#276B55"
        }
      }
    }
  }
}
